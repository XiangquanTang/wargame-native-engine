{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "native-ppo-training-benchmark.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "benchmark_id", "benchmark_version", "stage",
    "scenario_suite", "treatments", "train_seed_indices", "trained_sides",
    "opponent_ref", "ppo_config_ref", "parallel_runner_ref", "seed_config_ref",
    "green_template_policy_ref", "training_budget", "evaluation", "checkpoint",
    "replay_verification", "execution"
  ],
  "properties": {
    "schema_version": {"const": "native-ppo-training-benchmark/1.0"},
    "benchmark_id": {"enum": ["native-base-vs-eight-factor-ppo-pilot", "native-base-vs-eight-factor-ppo-full"]},
    "benchmark_version": {"enum": ["1.0.0", "1.0.1"]},
    "stage": {"enum": ["PILOT", "FULL"]},
    "scenario_suite": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"$ref": "#/$defs/scenario"}
    },
    "treatments": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"$ref": "#/$defs/treatment"}
    },
    "train_seed_indices": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
    "trained_sides": {"const": ["RED"]},
    "opponent_ref": {"$ref": "#/$defs/ref"},
    "ppo_config_ref": {"$ref": "#/$defs/ref"},
    "parallel_runner_ref": {"$ref": "#/$defs/ref"},
    "seed_config_ref": {"$ref": "#/$defs/ref"},
    "green_template_policy_ref": {"$ref": "#/$defs/ref"},
    "training_budget": {
      "type": "object", "additionalProperties": false,
      "required": ["unit", "transitions_per_run"],
      "properties": {
        "unit": {"const": "COMMITTED_ENVIRONMENT_TRANSITIONS"},
        "transitions_per_run": {"type": "integer", "minimum": 1}
      }
    },
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["namespace", "episode_indices", "episodes_per_checkpoint", "cadence_transitions", "action_selection", "primary_metric"],
      "properties": {
        "namespace": {"const": "EVALUATION"},
        "episode_indices": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
        "episodes_per_checkpoint": {"type": "integer", "minimum": 1},
        "cadence_transitions": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
        "action_selection": {"const": "MASKED_ARGMAX"},
        "primary_metric": {"const": "WIN_RATE_ENGINE_OUTCOME"}
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["cadence_transitions", "primary_selection"],
      "properties": {
        "cadence_transitions": {"type": "integer", "minimum": 1},
        "primary_selection": {"const": "LAST_CHECKPOINT_ONLY"}
      }
    },
    "replay_verification": {
      "type": "object", "additionalProperties": false,
      "required": ["reward", "engine"],
      "properties": {
        "reward": {"const": "EVERY_COMPLETED_EPISODE"},
        "engine": {"const": "FIRST_COMPLETED_EPISODE_PER_RUN"}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["run_scheduling", "num_envs", "num_workers"],
      "properties": {
        "run_scheduling": {"const": "RUNS_SEQUENTIAL"},
        "num_envs": {"type": "integer", "minimum": 1},
        "num_workers": {"type": "integer", "minimum": 1}
      }
    },
    "full_analysis": {
      "type": "object", "additionalProperties": false,
      "required": ["bootstrap_resamples", "bootstrap_seed"],
      "properties": {
        "bootstrap_resamples": {"const": 10000},
        "bootstrap_seed": {"type": "integer", "minimum": 1}
      }
    },
    "artifact_retention": {
      "type": "object", "additionalProperties": false,
      "required": ["episode_packages"],
      "properties": {
        "episode_packages": {"const": "FIRST_ENGINE_REPLAY_VERIFIED_ONLY"}
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "hash"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "path", "scenario_hash", "map_id", "max_ticks", "delta_time_seconds"],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "scenario_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "map_id": {"type": "string", "minLength": 1},
        "max_ticks": {"type": "integer", "minimum": 1},
        "delta_time_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "treatment": {
      "type": "object", "additionalProperties": false,
      "required": ["treatment_id", "reward_mode", "reward_ref", "shaping_ref"],
      "properties": {
        "treatment_id": {"enum": ["BASE_ONLY", "EIGHT_FACTOR_SHAPING"]},
        "reward_mode": {"enum": ["BASE_ONLY", "COMPOSITE_EIGHT_FACTOR"]},
        "reward_ref": {"$ref": "#/$defs/ref"},
        "shaping_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ref"}]}
      }
    }
  }
}
