{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "native-ppo-runner-config/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runner_id", "runner_version", "purpose", "mode", "trained_side", "fixed_opponent", "reward_mode", "ppo_config_ref", "seed_config_ref", "worker_index", "env_index", "run_limits", "checkpoint_every_updates", "evaluation_episodes", "rollout_model_mode", "device"],
  "properties": {
    "schema_version": {"const": "native-ppo-runner-config/1.0"},
    "runner_id": {"const": "native-single-seat-ppo-runner"},
    "runner_version": {"const": "1.0.0"},
    "purpose": {"enum": ["BASELINE_V1", "TEST_SMOKE"]},
    "mode": {"const": "TRAINED_SIDE_VS_FIXED_OPPONENT"},
    "trained_side": {"enum": ["RED", "BLUE"]},
    "fixed_opponent": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "deterministic"],
      "properties": {
        "kind": {"const": "NO_OP_AGENT"},
        "id": {"const": "native-no-op-fixed-opponent-v1"},
        "deterministic": {"const": true}
      }
    },
    "reward_mode": {"enum": ["BASE_ONLY", "COMPOSITE_EIGHT_FACTOR"]},
    "ppo_config_ref": {"$ref": "#/$defs/ref"},
    "seed_config_ref": {"$ref": "#/$defs/ref"},
    "worker_index": {"type": "integer", "minimum": 0},
    "env_index": {"type": "integer", "minimum": 0},
    "run_limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_updates", "max_environment_steps", "max_episodes"],
      "properties": {
        "max_updates": {"type": ["integer", "null"], "minimum": 1},
        "max_environment_steps": {"type": ["integer", "null"], "minimum": 1},
        "max_episodes": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "checkpoint_every_updates": {"type": ["integer", "null"], "minimum": 1},
    "evaluation_episodes": {"type": "integer", "minimum": 1},
    "rollout_model_mode": {"const": "EVAL_NO_GRAD"},
    "device": {"const": "CPU"}
  },
  "$defs": {
    "ref": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "hash"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
