{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "native-ppo-parallel-runner-config/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runner_id", "runner_version", "purpose", "base_vector_runner_ref", "worker_protocol_ref", "num_envs", "num_workers", "execution_mode", "start_method", "trained_side", "reward_mode", "ppo_config_ref", "seed_config_ref", "rollout_target_semantics", "aggregation_order", "failure_policy", "auto_restart", "operational"],
  "properties": {
    "schema_version": {"const": "native-ppo-parallel-runner-config/1.0"},
    "runner_id": {"const": "native-parallel-ppo-runner"},
    "runner_version": {"const": "1.0.0"},
    "purpose": {"enum": ["BASELINE_V1", "TEST_SMOKE"]},
    "base_vector_runner_ref": {"$ref": "#/$defs/ref"},
    "worker_protocol_ref": {"$ref": "#/$defs/ref"},
    "num_envs": {"type": "integer", "minimum": 1},
    "num_workers": {"type": "integer", "minimum": 1},
    "execution_mode": {"const": "SYNCHRONOUS_MULTIPROCESS"},
    "start_method": {"const": "SPAWN"},
    "trained_side": {"enum": ["RED", "BLUE"]},
    "reward_mode": {"enum": ["BASE_ONLY", "COMPOSITE_EIGHT_FACTOR"]},
    "ppo_config_ref": {"$ref": "#/$defs/ref"},
    "seed_config_ref": {"$ref": "#/$defs/ref"},
    "rollout_target_semantics": {"const": "TOTAL_TRANSITIONS_PER_UPDATE"},
    "aggregation_order": {"const": "STABLE_ENV_INDEX"},
    "failure_policy": {"const": "FAIL_WHOLE_ROLLOUT"},
    "auto_restart": {"const": false},
    "operational": {
      "type": "object", "additionalProperties": false,
      "required": ["worker_timeout_seconds"],
      "properties": {"worker_timeout_seconds": {"type": "number", "exclusiveMinimum": 0}}
    }
  },
  "$defs": {"ref": {"type": "object", "additionalProperties": false, "required": ["id", "version", "hash"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
