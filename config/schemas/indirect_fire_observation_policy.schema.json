{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "native-indirect-fire-observation-policy/1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "version", "authority_status", "impact_observation_policy", "requires_observer", "correction_level_policy", "correction_levels", "dispersion_table_ids", "observer_eligibility", "observation_interface", "authority_basis"],
  "properties": {
    "schema_version": {"const": "native-indirect-fire-observation-policy/1.1"},
    "policy_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "authority_status": {"const": "EXECUTABLE_AUTHORITY_READY"},
    "impact_observation_policy": {"const": "DYNAMIC_AT_IMPACT"},
    "requires_observer": {"const": false},
    "correction_level_policy": {"const": "OBSERVED_GRID_AND_TARGET"},
    "correction_levels": {"const": ["UNOBSERVED", "GRID_CORRECTED", "TARGET_CORRECTED"]},
    "dispersion_table_ids": {
      "const": {
        "UNOBSERVED": "indirect_fire.unobserved_dispersion",
        "GRID_CORRECTED": "indirect_fire.grid_corrected_dispersion",
        "TARGET_CORRECTED": "indirect_fire.target_corrected_dispersion"
      }
    },
    "observer_eligibility": {"const": ["CANONICAL_DRONE", "GROUND_PERSONNEL", "GROUND_VEHICLE"]},
    "observation_interface": {"const": "NativeEngine._indirect_fire_observation_at_impact/v1"},
    "authority_basis": {"type": "string", "minLength": 1}
  }
}
