{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native PPO Checkpoint Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "ppo_config_hash", "backend", "preprocessor",
    "action_encoder_hash", "action_capacity", "discount", "seed",
    "reward", "update_step", "sample_step", "semantic_hash"
  ],
  "properties": {
    "schema_version": {"const": "native-ppo-checkpoint/1.0"},
    "ppo_config_hash": {"$ref": "#/$defs/hash"},
    "backend": {"$ref": "#/$defs/identity"},
    "preprocessor": {"$ref": "#/$defs/identity"},
    "action_encoder_hash": {"$ref": "#/$defs/hash"},
    "action_capacity": {"const": 256},
    "discount": {"$ref": "#/$defs/identity"},
    "seed": {"$ref": "#/$defs/identity"},
    "reward": {"$ref": "#/$defs/identity"},
    "update_step": {"type": "integer", "minimum": 0},
    "sample_step": {"type": "integer", "minimum": 0},
    "semantic_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "hash"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "hash": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
