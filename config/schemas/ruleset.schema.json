{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wargame-native://ruleset/1.0",
  "type": "object",
  "required": ["schema_version", "ruleset_id", "ruleset_version", "ruleset_type", "description", "minimum_engine_version", "coordinate_unit", "deterministic", "random_rules", "timing", "movement", "visibility", "combat", "terminal", "operator_types", "weapon_types", "terrain_types"],
  "properties": {
    "schema_version": {"const": "native-ruleset/1.0"},
    "ruleset_id": {"type": "string", "minLength": 1},
    "ruleset_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "ruleset_type": {"enum": ["native_simplified", "historical_replay_calibrated_native_simplified"]},
    "description": {"type": "string", "minLength": 1},
    "minimum_engine_version": {"type": "string"},
    "coordinate_unit": {"type": "string"},
    "deterministic": {"const": true},
    "random_rules": {"type": "object"},
    "timing": {"type": "object"},
    "movement": {"type": "object"},
    "visibility": {"type": "object"},
    "combat": {"type": "object"},
    "terminal": {"type": "object"},
    "operator_types": {"type": "string"},
    "weapon_types": {"type": "string"},
    "terrain_types": {"type": "string"},
    "declared_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "calibration_provenance": {"type": "object"}
  },
  "additionalProperties": false
}
