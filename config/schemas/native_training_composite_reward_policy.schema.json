{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native Composite Training Reward Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "policy_id", "policy_version", "base", "shaping",
    "shaping_enabled"
  ],
  "properties": {
    "schema_version": {
      "const": "native-training-composite-reward-policy/1.0"
    },
    "policy_id": {"const": "native-base-plus-eight-factor-potential"},
    "policy_version": {"const": "1.0.0"},
    "base": {"$ref": "#/$defs/policyIdentity"},
    "shaping": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/policyIdentity"}
      ]
    },
    "shaping_enabled": {"type": "boolean"}
  },
  "$defs": {
    "policyIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version", "policy_hash"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
